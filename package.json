{
  "name": "spotlight.js",
  "version": "0.7.8",
  "description": "Modern HTML5 Image Gallery",
  "homepage": "https://github.com/nextapps-de/spotlight/",
  "author": "Thomas Wilkerling",
  "copyright": "Nextapps GmbH",
  "license": "Apache-2.0",
  "keywords": [
    "gallery",
    "lightbox",
    "photo-gallery",
    "javascript-library",
    "image-viewer",
    "image-gallery",
    "lightbox-gallery-plugin",
    "gallery-plugin",
    "gallery-extension",
    "gallery-widget",
    "lightbox-gallery",
    "gallery-template",
    "gallery-viewer",
    "gallery-simple",
    "lightbox-plugin"
  ],
  "bugs": {
    "url": "https://github.com/nextapps-de/spotlight/issues",
    "email": "info@nextapps.de"
  },
  "main": "src/js/spotlight.js",
  "browser": "dist/spotlight.bundle.js",
  "preferGlobal": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/nextapps-de/spotlight.git"
  },
  "scripts": {
    "copy": "npx cpx2 \"src/img/*.*\" dist/img/",
    "clean": "if exist dist rmdir dist /s /q && mkdir dist && if exist dist rmdir tmp /s /q && mkdir tmp",
    "build:css": "lessc src/css/spotlight.less src/css/spotlight.css",
    "build:css:bundle": "node task/bundle --image && lessc --clean-css=\"--s1 --advanced\" tmp/bundle.less dist/css/spotlight.min.css && csso dist/css/spotlight.min.css --output dist/css/spotlight.min.css",
    "build:js": "node task/build",
    "build:bundle": "node task/build --bundle",
    "build:svg": "node task/svgo",
    "build": "npm run clean && npm run copy && npm run build:svg && npm run build:css && npm run build:css:bundle && node task/bundle --style && npm run build:js && npm run build:bundle && echo Build Complete. && exit 0",
    "server": "http-server -p 8080"
  },
  "files": [
    "dist/",
    "src/",
    "task/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "readme": "README.md",
  "devDependencies": {
    "cpx2": "^7.0.1",
    "csso": "^5.0.5",
    "csso-cli": "^4.0.2",
    "google-closure-compiler": "^20251111.0.0",
    "less": "^4.2.2",
    "postcss": "^8.4.49",
    "autoprefixer": "^10.4.20",
    "less-plugin-clean-css": "^1.5.1",
    "svgo": "^3.3.2",
    "http-server": "^14.1.1"
  }
}
